# ==========================================
# AWS / S3 Configuration
# ==========================================
AWS_REGION=ap-south-2
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# S3 Folder Prefixes
S3_RAW_PDFS_PREFIX=pdfs/
S3_PARSED_PREFIX=parsed/
S3_CHUNKS_PREFIX=chunks/
S3_EMBEDDINGS_PREFIX=embeddings/

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
# IMPORTANT: Set a strong password — this is used by both postgres and go-api-gateway
POSTGRES_PASSWORD=change_me_strong_password

# ==========================================
# LLM / AI API Configuration
# ==========================================
# Inference order: Gemini (primary, free tier) -> Groq (fallback once exhausted).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your-groq-api-key

# ==========================================
# Retrieval / Reranking Configuration
# ==========================================
# Cross-encoder (bge-reranker-v2-m3) sigmoid score [0-1] required to answer from a chunk.
RERANK_THRESHOLD=0.5
# Candidates pulled from the vector store before the reranker narrows them down.
RETRIEVAL_CANDIDATE_POOL=20

# ==========================================
# Vector Database Configuration (ChromaDB, embedded)
# ==========================================
CHROMA_DB_PATH=data/chromadb

# ==========================================
# Local Ingestion Storage Paths
# ==========================================
LOCAL_RAW_PDFS_DIR=data/raw_pdfs
LOCAL_PARSED_DIR=data/parsed
LOCAL_CHUNKS_DIR=data/chunks
LOCAL_EMBEDDINGS_DIR=data/embeddings

# ==========================================
# Application Configuration
# ==========================================
PORT=8081
# Set this to your domain: https://aether-rag-pipeline.duckdns.org
UI_ORIGIN=*
PYTHON_SERVICE_URL=http://python-rag-engine:8000
UPLOAD_PATH=/app/uploads
ENVIRONMENT=production

# ==========================================
# Observability (OpenTelemetry) — STRICT SPLIT across two platforms
# ==========================================
# Each exporter is opt-in: leave an endpoint blank to disable that exporter.
# The same W3C trace_id flows across Go -> Python, is echoed to clients as the
# X-Trace-ID response header, and is stamped into every log line — so one id ties
# an OpenObserve trace to its Phoenix LLM view.

# --- OpenObserve: API / infra traces (Go gateway + FastAPI server/retrieval/rerank) ---
# OTLP/gRPC endpoint (host:port, no scheme needed). Self-hosted OpenObserve gRPC
# ingest is typically port 5081.
OPENOBSERVE_OTLP_ENDPOINT=openobserve:5081
# OTLP metadata headers, comma-separated "k=v" pairs. OpenObserve routes traces by
# these — this is what places them into the correct project (organization) + stream:
#   authorization = Basic <base64(email:token)>   (from OpenObserve > Ingestion > OTEL)
#   organization  = <your org / project slug>
#   stream-name   = <target trace stream, e.g. rag_traces>
OPENOBSERVE_OTLP_HEADERS=authorization=Basic REPLACE_ME,organization=default,stream-name=rag_traces

# --- Phoenix: LLM traces (Gemini via google-genai, Groq via openai client) ---
# Self-hosted Phoenix OTLP/gRPC endpoint (default gRPC port 4317). No auth needed
# for a local Phoenix; leave blank to disable LLM tracing.
PHOENIX_OTLP_ENDPOINT=phoenix:4317
PHOENIX_OTLP_HEADERS=

# Single-collector setup: if OPENOBSERVE_OTLP_ENDPOINT is unset, both services fall
# back to this generic endpoint (and OTEL_EXPORTER_OTLP_HEADERS) for ALL traces —
# API/infra and LLM alike. Use this when one OTLP collector fronts both platforms.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP metadata headers, comma-separated "k=v". For a collector behind basic auth:
#   authorization=Basic <base64("user:token")>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=
