# ==========================================
# AWS / S3 Configuration
# ==========================================
AWS_REGION=ap-south-2
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# S3 Folder Prefixes
S3_RAW_PDFS_PREFIX=pdfs/
S3_PARSED_PREFIX=parsed/
S3_CHUNKS_PREFIX=chunks/
S3_EMBEDDINGS_PREFIX=embeddings/

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_URL=postgres://nexus:password@postgres:5432/nexus_db?sslmode=disable

# ==========================================
# LLM / AI API Configuration
# ==========================================
GROQ_API_KEY=your-groq-api-key
USE_GROQ=true
GEMINI_API_KEY=your-gemini-api-key

# ==========================================
# Vector Database Configuration (Qdrant/Chroma)
# ==========================================
VECTOR_BACKEND=qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
CHROMA_DB_PATH=data/chromadb

# ==========================================
# Local Ingestion Storage Paths
# ==========================================
LOCAL_RAW_PDFS_DIR=data/raw_pdfs
LOCAL_PARSED_DIR=data/parsed
LOCAL_CHUNKS_DIR=data/chunks
LOCAL_EMBEDDINGS_DIR=data/embeddings

# ==========================================
# Application Configuration
# ==========================================
PORT=8080
UI_ORIGIN=*
PYTHON_SERVICE_URL=http://python-rag-engine:8000
UPLOAD_PATH=/app/uploads
ENVIRONMENT=production
