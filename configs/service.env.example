# Runtime environment
ENVIRONMENT=local

# Search index backend
SEARCH_BACKEND=opensearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=db-research-rag-v1
OPENSEARCH_TIMEOUT_SECONDS=10

# Cache backend
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=900

# Embedding and retrieval
EMBEDDING_DIMENSION=1536
TOP_K_RETRIEVAL=8
TOP_K_RERANK=4

# Storage Configuration
LOCAL_RAW_PDFS_DIR=data/raw_pdfs
LOCAL_PARSED_DIR=data/parsed
LOCAL_CHUNKS_DIR=data/chunks
LOCAL_EMBEDDINGS_DIR=data/embeddings
S3_RAW_PDFS_PREFIX=raw_pdfs/
S3_PARSED_PREFIX=parsed/
S3_CHUNKS_PREFIX=chunks/
S3_EMBEDDINGS_PREFIX=embeddings/

# Optional AWS endpoints for deployment environments
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-production-bucket-name
