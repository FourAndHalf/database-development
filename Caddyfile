(app_routes) {
    # API Routes (v1, healthz, pdfs)
    handle /v1/* {
        reverse_proxy go-api-gateway:8081
    }
    handle /healthz {
        reverse_proxy go-api-gateway:8081
    }
    handle /pdfs/* {
        reverse_proxy go-api-gateway:8081
    }

    # All other requests go to the Angular UI
    handle {
        reverse_proxy angular-ui:80
    }

    # Log requests
    log {
        output file /var/log/caddy/access.log
    }
}

aether-rag-pipeline.duckdns.org {
    import app_routes
}

# Plain-HTTP local/dev entry point — bare ":80" is port-only (no Host match),
# so it skips automatic HTTPS/ACME and just serves on whatever host port this
# container's 80 is published to (see docker-compose.yml caddy "ports:").
:80 {
    import app_routes
}
