:80 {
    # Serve Jenkins
    handle_path /jenkins* {
        reverse_proxy jenkins:8080
    }

    # API Routes (v1, healthz, pdfs)
    handle /v1/* {
        reverse_proxy go-api-gateway:8080
    }
    handle /healthz {
        reverse_proxy go-api-gateway:8080
    }
    handle /pdfs/* {
        reverse_proxy go-api-gateway:8080
    }

    # All other requests go to the Angular UI
    handle {
        reverse_proxy angular-ui:80
    }

    # Log requests
    log {
        output file /var/log/caddy/access.log
    }
}
